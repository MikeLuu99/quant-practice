---
import Layout from '../layouts/Layout.astro';
import '../styles/assessment.css';
import '../styles/trainer.css';
import profiles from '../../../backend/internal/games/trainer_profiles.json';
const categories=['Numerical','Trading','Probability and Statistics','Estimation','Cognitive'];
---
<Layout title="Trainers">
 <section id="trainer-intro" class="trainer-hero"><div><span class="eyebrow">22 skill trainers</span><h1>Build the instinct.<br/><em>One skill at a time.</em></h1><p>Practice math, trading, memory, and decision-making.</p></div><div class="trainer-hero-art" aria-hidden="true"><span>22</span><svg viewBox="0 0 250 160"><path d="M10 140H240M10 100H240M10 60H240M10 20H240M30 10V150M80 10V150M130 10V150M180 10V150M230 10V150"/><path class="trainer-art-line" d="M10 130L60 110L100 120L150 65L185 80L240 10"/></svg></div></section>
 <div id="trainer-error" class="err" role="alert"></div>
 <section id="trainer-setup">
  <div class="trainer-section-label"><span class="eyebrow">Choose a trainer</span><a href="#trainer-catalog" class="btn sm">Browse all trainers ↓</a></div>
  <div class="trainer-setup-grid">
   <form id="trainer-start-form" class="trainer-config"><h2>Set up your practice.</h2><div class="trainer-fields">
    <label class="field-label">Trainer<select id="trainer-select">{profiles.map(p=><option value={p.id}>{p.title}</option>)}</select></label>
    <label class="field-label">Mode<select id="trainer-mode"></select></label>
    <label class="field-label" data-setting="duration">Minutes<input id="trainer-duration" type="number" value="2" min="1" max="15" step="1"/></label>
    <label class="field-label" data-setting="format">Answer format<select id="trainer-format"><option value="open">Type an answer</option><option value="choice">Multiple choice</option></select></label>
    <label class="field-label" data-setting="difficulty">Difficulty<select id="trainer-difficulty"><option value="1">Foundation</option><option value="2" selected>Developing</option><option value="3">Stretch</option></select></label>
    <label class="field-label" data-setting="family">Number type / topic<select id="trainer-family"><option value="mixed">Mixed</option></select></label>
    <label class="field-label" data-setting="digits">Operand digits<select id="trainer-digits"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>
    <label class="field-label" data-setting="places">Decimal places<select id="trainer-places"><option>2</option><option>3</option><option selected>4</option><option>5</option></select></label>
    <label class="field-label" data-setting="span">Digit span<select id="trainer-span"><option value="0">Adaptive · 4–8 digits</option>{[4,5,6,7,8].map(n=><option value={n}>Fixed · {n} digits</option>)}</select></label>
    <label class="field-label" data-setting="faces">Cube face style<select id="trainer-faces">{['mixed','colors','shapes','dice','numbers','letters','icons','patterns'].map(v=><option value={v}>{v}</option>)}</select></label>
    <label class="field-label" data-setting="device">Input device<select id="trainer-device"><option value="mouse">Mouse</option><option value="trackpad">Trackpad</option><option value="touch">Touch</option><option value="other">Other</option></select></label>
   </div>
   <fieldset id="trainer-operations" data-setting="operations"><legend class="field-label">Operations</legend>{['+','-','*','/','%'].map((op,i)=><label><input type="checkbox" name="operation" value={op} checked/><span>{['+','−','×','÷','%'][i]}</span></label>)}</fieldset>
   <div id="trainer-fact-picker" data-setting="fact" hidden><label class="field-label">Find a Fermi question<input type="search" id="trainer-fact-search" placeholder="Search the 24 original questions…"/></label><label class="field-label">Question<select id="trainer-fact"><option value="">Random original question</option></select></label></div>
   <details class="trainer-advanced"><summary>Player & seed</summary><div class="trainer-fields"><label class="field-label">Player<input id="trainer-player" value="p1" maxlength="80" required/></label><label class="field-label">Seed<input id="trainer-seed" inputmode="numeric" placeholder="Random each session"/></label></div><p class="field-note">Reuse a seed and settings to repeat a challenge.</p></details>
   <button type="submit" class="btn primary" id="trainer-start">Start practice ↗</button><p class="field-note" id="trainer-start-note"></p>
  </form>
  <aside id="trainer-guide" class="trainer-guide"></aside>
 </div>
 <div id="trainer-catalog"><div class="trainer-section-label"><span class="eyebrow">All trainers</span><span class="mono" id="trainer-count">22 trainers</span></div><div class="trainer-filters"><input type="search" id="trainer-search" placeholder="Find a skill or trainer…" aria-label="Search trainers"/><select id="trainer-category" aria-label="Trainer category"><option value="">All disciplines</option>{categories.map(c=><option>{c}</option>)}</select></div><div class="trainer-cards">{profiles.map((p,i)=><button class="trainer-card" data-trainer={p.id} data-category={p.category} data-search={`${p.title} ${p.category} ${p.description} ${p.modes.join(' ')}`.toLowerCase()}><span class="eyebrow">{String(i+1).padStart(2,'0')} / {p.category}</span><div class="trainer-card-symbol" aria-hidden="true">{['×','↗','⅝','▤','Δ','ƒ','◒','P','≈','⇄','→','•••','⬡','≡','▦','↗','◉','24','◯','▥','?','◴'][i]}</div><h3>{p.title}</h3><p>{p.description}</p><span class="trainer-card-foot"><small>{p.modes.length} {p.modes.length===1?'mode':'modes'} · {p.duration_ms?`${p.duration_ms/60000} min default`:p.rounds?`${p.rounds} rounds / items`:'Self paced'}</small><b class="control-label">Select ↗</b></span></button>)}</div><p id="trainer-empty" hidden>No trainers match your filters.</p></div>
 <details class="panel trainer-replay"><summary>Verify a replay</summary><p>Upload an exported replay to verify its result.</p><label class="field-label">Replay file (.json)<input type="file" id="trainer-replay-file" accept="application/json,.json"/></label><p id="trainer-replay-status" role="status"></p></details>
 <p class="trainer-source">Original practice content.</p>
 </section>
 <section id="trainer-session" hidden><div class="trainer-session-head"><div><span class="eyebrow" id="trainer-session-mode"></span><h2 id="trainer-session-title"></h2></div><div class="trainer-live-stats"><div><span class="eyebrow" id="trainer-clock-label">Remaining</span><b id="trainer-clock">—</b></div><div><span class="eyebrow">Progress</span><b id="trainer-progress">—</b></div><div><span class="eyebrow" id="trainer-score-label">Score</span><b id="trainer-score">0</b></div></div></div><div class="trainer-session-layout"><div><div id="trainer-board" class="trainer-board"></div><div id="trainer-action-error" class="err" role="alert"></div><div class="trainer-session-tools"><button id="trainer-end" class="btn sm">End session</button><span id="trainer-connection" class="mono" role="status">Connected</span><button id="trainer-new" class="btn sm">Change trainer ↗</button></div></div><aside class="trainer-session-guide"><p id="trainer-session-tip"></p><details><summary>Rules & scoring</summary><div id="trainer-session-rules"></div><p id="trainer-timing-note" class="field-note">Leaving or refreshing the tab marks the session as interrupted.</p></details><div id="trainer-book"></div></aside></div><div id="trainer-results" hidden></div></section>
</Layout>
<script>import '../lib/trainer';</script>
