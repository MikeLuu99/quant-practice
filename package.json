{
  "name": "quant-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "build": "npm run build:staging",
    "dev:worker": "npm run build:worker && vite --host 127.0.0.1",
    "deploy:staging": "cf deploy --prebuilt --mode staging",
    "deploy:production": "cf deploy --prebuilt --mode production",
    "test:worker": "node --test worker/*.test.mjs",
    "build:staging": "bun --cwd frontend run build && npm run build:worker && vite build --mode staging",
    "build:production": "bun --cwd frontend run build && npm run build:worker && vite build --mode production",
    "test:wasm": "node --experimental-vm-modules scripts/smoke-wasm.mjs"
  },
  "devDependencies": {
    "cf": "1.0.0-rc.1",
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || >=26.12.0"
  }
}
